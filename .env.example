# Neon Postgres
DATABASE_URL=postgres://user:password@host:5432/db

# Neon Auth with Google OAuth
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-at-least-32-random-characters

# Railway Bucket, S3 compatible
BUCKET=your-railway-bucket
ENDPOINT=https://storage.railway.app
REGION=auto
ACCESS_KEY_ID=your-access-key
SECRET_ACCESS_KEY=your-secret-key

# Firecrawl content source
FIRECRAWL_API_KEY=fc-...

# Optional Notion webhook or API work
NOTION_API_KEY=ntn_...
NOTION_VERSION=2026-03-11
NOTION_PUBLIC_NOTION_API_PAGE_ALLOWLIST=35cf0ada243c808abb24deca7fe22fab
NOTION_WEBHOOK_VERIFICATION_TOKEN=secret_...

# Inngest Cloud
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Codex generation
AI_GATEWAY_API_KEY=...
CODEX_ACCESS_TOKEN=
CODEX_AUTH_JSON_BASE64=
CODEX_BIN=codex
CODEX_GENERATION_ENABLED=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
